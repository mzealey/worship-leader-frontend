{
  "name": "worship-leader",
  "private": true,
  "version": "10.1.5",
  "type": "module",
  "description": "Worship Leader app",
  "workspaces": [
    "abc2svg",
    "wa-sqlite"
  ],
  "browserslist": [
    "last 2 versions",
    "since 2019",
    "> 0.2%",
    "not dead",
    "not ie <= 11"
  ],
  "scripts": {
    "lint": "yarn lint:prettier && yarn lint:eslint:fix && yarn lint:typescript && yarn lint:typescript:spec && yarn lint:knip",
    "lint:prettier": "prettier --write {spec,src,tests}/**/*.{js,jsx,ts,tsx,css,scss} *.{js,mjs,ts,jsx,tsx} --experimental-cli",
    "lint:eslint": "eslint src/ spec/ tests/",
    "lint:eslint:fix": "eslint --fix src/ spec/ tests/",
    "lint:typescript": "tsc --noEmit",
    "lint:typescript:spec": "tsc --noEmit --project tsconfig.spec.json",
    "lint:typescript:tools": "tsc --noEmit --project tsconfig.playwright.json",
    "lint:knip": "knip",
    "dev": "vite",
    "test": "yarn test:coverage && yarn test:browser",
    "test:unit;watch": "vitest --config vitest.config.mjs --dir spec --exclude '**/*.ui.spec.*'",
    "test:unit": "vitest run --config vitest.config.mjs --dir spec --exclude '**/*.ui.spec.*'",
    "test:ui": "vitest run --config vitest.config.mjs --dir spec '**/*.ui.spec.*'",
    "test:coverage": "vitest run --config vitest.config.mjs --dir spec --coverage",
    "test:browser": "playwright test",
    "test:browser:ui": "playwright test --ui",
    "test:browser:headed": "playwright test --headed",
    "build": "concurrently yarn:build:test:*",
    "build:prod": "concurrently yarn:build:prod:*",
    "build:test:www": "vite build --mode www --outDir build/www",
    "build:prod:www": "vite build --mode www --outDir ../../root/static/offline --emptyOutDir",
    "build:test:chrome": "vite build --mode chrome --outDir build/chrome",
    "build:prod:chrome": "vite build --mode chrome --outDir build/chrome",
    "build:test:edge": "vite build --mode edge --outDir build/edge",
    "build:prod:edge": "vite build --mode edge --outDir build/edge",
    "build:test:editor": "vite build --mode editor --outDir build/editor",
    "build:prod:editor": "vite build --mode editor --outDir ../../root/static/editor/js/",
    "build:test:phonegap": "vite build --mode phonegap --outDir build/phonegap",
    "build:prod:phonegap": "vite build --mode phonegap --outDir ../phonegap/www --emptyOutDir"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fingerprintjs/botd": "^2.0.0",
    "@mdi/js": "^7.4.47",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "caniuse-lite": "^1.0.30001805",
    "comlink": "^4.4.2",
    "core-js": "^3.49.0",
    "deepmerge": "^4.1.1",
    "grapheme-splitter": "^1.0.4",
    "js-cookie": "^3.0.8",
    "lodash": "^4.18.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "rxjs": "^7.8.2",
    "stacktrace-js": "^2.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@originjs/vite-plugin-commonjs": "^1.0.3",
    "@playwright/test": "^1.61.1",
    "@react-router/node": "^8.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-legacy": "^8.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "better-sqlite3": "^12.11.1",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "knip": "^6.26.0",
    "prettier": "^3.9.5",
    "prettier-plugin-organize-imports": "^4.3.0",
    "sass-embedded": "^1.100.0",
    "terser": "^5.49.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vite-multiple-assets": "^2.2.6",
    "vite-plugin-circular-dependency": "^0.6.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "author": "Mark Zealey",
  "license": "GPL-3.0-or-later",
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
